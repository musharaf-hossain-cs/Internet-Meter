<Window x:Class="InternetMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InternetMeter.Controls"
        Title="Internet Meter" Width="920" Height="650" MinWidth="760" MinHeight="540"
        Icon="Assets/Brand/internet-meter.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Width="46" Height="46" Margin="0,0,12,0"
                       Source="Assets/Brand/internet-meter-64.png"
                       Stretch="Uniform" SnapsToDevicePixels="True"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="Internet Meter"/>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="Live network activity on your taskbar"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#162B3B" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Foreground="#7DD3FC" Text="● Monitoring" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0" SelectionChanged="Tabs_OnSelectionChanged">
            <TabItem Header="Live">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="DOWNLOAD"/>
                                <TextBlock Foreground="{StaticResource DownloadBrush}" FontSize="26" FontWeight="SemiBold" Text="{Binding DownloadSpeed}"/>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding SessionDownload, StringFormat=Session: {0}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="UPLOAD"/>
                                <TextBlock Foreground="{StaticResource UploadBrush}" FontSize="26" FontWeight="SemiBold" Text="{Binding UploadSpeed}"/>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding SessionUpload, StringFormat=Session: {0}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="SESSION"/>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SessionDuration}"/>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding ActiveAdapter}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <controls:TrafficGraph x:Name="TrafficGraph"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                <TextBlock Foreground="{StaticResource DownloadBrush}" Text="● Download" Margin="0,0,14,0"/>
                                <TextBlock Foreground="{StaticResource UploadBrush}" Text="● Upload"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding PeakDownload, StringFormat=Peak download: {0}}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" Text="{Binding PeakUpload, StringFormat=Peak upload: {0}}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="AppsTab" Header="Apps">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="4,0,0,10" Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding AppTrafficStatus}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AppTrafficRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                              RowBackground="#111827" AlternatingRowBackground="#172033" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding Process}" Width="1.5*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="0.5*"/>
                            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/>
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="UsageTab" Header="Usage &amp; reports">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <Button Content="Refresh" Click="RefreshUsage_OnClick"/>
                        <Button Content="Export CSV" Click="ExportCsv_OnClick"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UsageRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                              RowBackground="#111827" AlternatingRowBackground="#172033" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Day}" Width="*"/>
                            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/>
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Stopwatch">
                <Grid Margin="0,16,0,0">
                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="12" Padding="36" Width="560" Height="330"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="TRANSFER STOPWATCH"/>
                            <TextBlock HorizontalAlignment="Center" FontFamily="Consolas" FontSize="48" Margin="0,12" Text="{Binding StopwatchTime}"/>
                            <Grid Margin="0,8,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="TRANSFERRED"/>
                                    <TextBlock HorizontalAlignment="Center" FontSize="20" Text="{Binding StopwatchTransferred}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="AVERAGE"/>
                                    <TextBlock HorizontalAlignment="Center" FontSize="20" Text="{Binding StopwatchAverage}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="StopwatchButton" Width="110" Content="Start / Pause" Click="Stopwatch_OnClick"/>
                                <Button Width="90" Content="Reset" Click="ResetStopwatch_OnClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ConnectionsTab" Header="Connections">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                   Text="Active TCP listeners and connections, grouped by owning process."/>
                        <Button Margin="14,0,0,0" Content="Refresh" Click="RefreshConnections_OnClick"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" GridLinesVisibility="Horizontal"
                              RowBackground="#111827" AlternatingRowBackground="#172033" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.2*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="0.5*"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.6*"/>
                            <DataGridTextColumn Header="Local endpoint" Binding="{Binding LocalEndpoint}" Width="1.5*"/>
                            <DataGridTextColumn Header="Remote endpoint" Binding="{Binding RemoteEndpoint}" Width="1.5*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Display" Margin="0,0,0,8"/>
                        <Border Background="#172033" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Windows 10: right-click an empty part of the taskbar, then choose Toolbars → Internet Meter to show or hide the embedded meter. Windows 11 does not provide the Toolbars feature."/>
                        </Border>
                        <CheckBox Content="Show values in bits per second" IsChecked="{Binding Settings.DisplayBits}"/>
                        <CheckBox Content="Use a single-line taskbar layout" IsChecked="{Binding Settings.CompactSingleLine}"/>
                        <CheckBox Content="Keep dashboard always on top" IsChecked="{Binding Settings.AlwaysOnTop}"/>
                        <CheckBox Content="Start Internet Meter with Windows" IsChecked="{Binding Settings.StartWithWindows}"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Refresh interval"/>
                            <ComboBox Grid.Column="1" x:Name="RefreshIntervalCombo" SelectedValuePath="Tag">
                                <ComboBoxItem Content="250 ms" Tag="250"/><ComboBoxItem Content="500 ms" Tag="500"/>
                                <ComboBoxItem Content="1 second" Tag="1000"/><ComboBoxItem Content="2 seconds" Tag="2000"/>
                                <ComboBoxItem Content="5 seconds" Tag="5000"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Download color"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.DownloadColor}"/>
                            <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="#RRGGBB" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Upload color"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.UploadColor}"/>
                            <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="#RRGGBB" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Smoothing"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding Settings.SmoothingFactor}"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Sustained-speed alert"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.SpeedAlertMegabitsPerSecond}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="Mbps (0 disables)" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Alert after"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.SpeedAlertDurationSeconds}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="seconds" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>

                        <Separator Margin="0,14" Background="#475569"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Usage quota" Margin="0,0,0,8"/>
                        <CheckBox Content="Notify when quota threshold is reached" IsChecked="{Binding Settings.QuotaNotificationsEnabled}"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Monthly quota"/>
                            <TextBox Grid.Column="1" x:Name="QuotaText"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="GB (0 disables)" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Warn at"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.QuotaWarningPercent}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="%"/>
                        </Grid>

                        <Separator Margin="0,14" Background="#475569"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Network adapters" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="Select none or all to monitor every eligible active adapter." Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding Status}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Include VPN, tunnel, and virtual adapters" IsChecked="{Binding Settings.IncludeVirtualAdapters}" Margin="0,10,0,0"/>

                        <Button Content="Save and apply settings" HorizontalAlignment="Left" Margin="0,20,0,20" Click="SaveSettings_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

